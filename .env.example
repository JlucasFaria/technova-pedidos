# Copie este arquivo para .env antes de subir o ambiente:
#   cp .env.example .env
#
# O arquivo .env nao e versionado (ver .gitignore). Os valores abaixo sao
# apenas o padrao de desenvolvimento - em producao, use credenciais proprias.

# Porta em que a API sera exposta
PORT=3000

# Versao exibida no endpoint /api/health e usada como tag da imagem
APP_VERSION=1.0.1

# Credenciais do PostgreSQL utilizadas pelo docker-compose
POSTGRES_USER=technova
POSTGRES_PASSWORD=technova123
POSTGRES_DB=pedidos

# String de conexao usada na execucao local, fora do docker-compose.
# Quando ausente, a aplicacao usa o armazenamento em memoria
# (modo desenvolvimento e testes, sem dependencia de banco).
# DATABASE_URL=postgres://technova:technova123@localhost:5432/pedidos
